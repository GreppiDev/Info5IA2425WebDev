# Copy to .env for local development and change values as needed
# MariaDB connection settings

# --- CONFIGURAZIONE PER IL CONTAINER (MariaDB) ---
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=database_name
MARIADB_USER=db_user
MARIADB_PASSWORD=db_password

# --- CONFIGURAZIONE RETE ---
# Porta interna al container (standard 3306)
MARIADB_PORT=3306
# Porta esposta sull'host (modificabile se hai altri DB installati)
MARIADB_HOST_PORT=3306

# --- CONFIGURAZIONE PER L'APPLICAZIONE ---
# L'app userà il nome del servizio definito nel compose per connettersi
MARIADB_HOST=mariadb
